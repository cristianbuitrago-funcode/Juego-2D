# Puerto del servidor de juego (Socket.IO + archivos estáticos del cliente)
PORT=3000
# Orígenes permitidos para CORS (separados por coma). Solo necesario si el cliente se sirve desde otro dominio
# (por ejemplo, la app Android empaquetada con Capacitor). Vacío = solo mismo origen.
CORS_ORIGINS=
# URL del servidor para el cliente cuando NO se sirve desde el mismo origen (build de Android / hosting separado)
VITE_SERVER_URL=
